{
  "_about": "Whether a query waits for its filters, per route. A case names the route, the text typed and the filters set (wire parameter names; their values do not matter), the rules in force and the answer: `wait`, or `send`. Rules use the session's wire names. `fallback` is what applies when the session carries no per-route rules: today's service rules, with the grant's filter_min_stem as the stem. Shared by the service, its Python port and this SDK.",
  "rules": {
    "fallback": {
      "businesses": {
        "count": "stem",
        "gated": "all",
        "short_allowed_with": []
      },
      "people": {
        "count": "person_name",
        "gated": "all",
        "short_allowed_with": ["business.name"]
      },
      "addresses": { "count": "stem", "gated": "all", "short_allowed_with": [] }
    }
  },
  "cases": [
    {
      "route": "businesses",
      "q": "halc",
      "filters": ["state"],
      "min_stem": 5,
      "expect": "wait",
      "missing": 1
    },
    {
      "route": "businesses",
      "q": "halcy",
      "filters": ["state"],
      "min_stem": 5,
      "expect": "send"
    },
    {
      "route": "businesses",
      "q": "ha",
      "filters": [],
      "min_stem": 5,
      "expect": "send"
    },
    {
      "route": "businesses",
      "q": "hal",
      "filters": ["person.name"],
      "min_stem": 5,
      "expect": "wait",
      "missing": 2
    },
    {
      "route": "businesses",
      "q": "hal",
      "filters": ["address.text"],
      "min_stem": 5,
      "expect": "wait",
      "missing": 2
    },
    {
      "route": "businesses",
      "q": "hal",
      "filters": ["state"],
      "min_stem": 3,
      "expect": "send"
    },
    {
      "route": "businesses",
